{
  "name": "active-bezel",
  "version": "0.4.1",
  "description": "Active Bezels: executable companions to a specific ROM. A .ab package runs once per emulated frame, reads the emulator's live memory regions, and renders the complete final scene — maps, HUDs, reconstructed world graphics, artwork — around or over the original game picture. This is the format spec, the reference runtime, and the packaging tool.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package": "./src/Package.js",
    "./matcher": "./src/Matcher.js",
    "./regions": "./src/Regions.js",
    "./config": "./src/Config.js",
    "./runtime": "./src/Runtime.js",
    "./compositor": "./src/Compositor.js",
    "./gpu-compositor": "./src/GpuCompositor.js",
    "./decode-image": "./src/decodeImage.js",
    "./host": "./src/Host.js",
    "./sdk/abi.json": "./sdk/abi.json",
    "./sdk/active_bezel.h": "./sdk/active_bezel.h",
    "./package.json": "./package.json",
    "./runtimes/*": "./runtimes/*"
  },
  "bin": {
    "abtool": "bin/abtool.js"
  },
  "files": [
    "index.js",
    "src/",
    "sdk/",
    "bin/",
    "runtimes/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!docs/media/"
  ],
  "scripts": {
    "check:runtimes": "node scripts/check-runtimes.mjs",
    "pretest": "node scripts/check-runtimes.mjs",
    "test": "node --test test/*.test.js",
    "verify": "npm run check:runtimes && npm test"
  },
  "keywords": [
    "active-bezel",
    "bezel",
    "emulator",
    "libretro",
    "retro",
    "wasm",
    "overlay"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Luis Montes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monteslu/active-bezels.git"
  },
  "bugs": {
    "url": "https://github.com/monteslu/active-bezels/issues"
  },
  "homepage": "https://github.com/monteslu/active-bezels#readme",
  "dependencies": {
    "native-gles": "^0.5.0",
    "yauzl": "^3.2.0"
  },
  "optionalDependencies": {
    "wasmcart": "^0.16.0"
  }
}
